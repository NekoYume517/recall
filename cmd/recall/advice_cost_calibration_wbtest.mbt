// ============================================================================
// advice 成本守卫：把「上限档要多久」从**本机秒数**改成**机器无关的单元预算**
//
// 缺陷（第二十轮 RC-20-1，2026-11-28）：
//
// 上一轮把上限定成 3.4e8 工作单元（`(hi+2) · days² · hi`），并把「上限档实测
// ≤ 40 s（本机 16 s，留 2 倍机器余量）」写成了测试断言。问题是**这个判据绑死在
// 开发机**：3.4e8 单元在开发机上 ≈ 16 s，在慢 4 倍的机器上 ≈ 64 s，守卫照样
// 放行，而测试仍然绿（它只断言常量 16018 ≤ 40000，不测任何东西）。
//
// 本机实测（native release、独立进程、每档 3 次取最小，见
// `audit/2026-11-28/recall-evidence/perf/units-vs-time.md`）：
//
//     days   工作单元    实测      每单元耗时
//      10     4.0e6      0.249 s   61.7 ns
//      20     1.6e7      0.685 s   42.4 ns
//      30     3.6e7      1.640 s   45.1 ns
//      40     6.5e7      2.517 s   38.9 ns
//      60     1.45e8     7.699 s   52.9 ns
//      70     1.98e8    10.408 s   52.6 ns
//      80     2.59e8    15.631 s   60.5 ns
//      90     3.27e8    17.906 s   54.7 ns
//
// 结论：**不是严格线性**。低档（≤ 40 天）约 39–45 ns/单元，高档（≥ 60 天）
// 约 53–62 ns/单元——高阶那一段每单元贵 30%–40%，因为探测次数 `hi+2` 的近似
// 把「命中即停」的真实工作量估高了，而 days 越大单次模拟里「积压排序/扫描」
// 的常数项越重。拟合 `t = -0.44 s + 5.71e-8 s/unit`，R² = 0.991，残差最大
// 1.3 s。所以「单元数 → 秒数」只能当**量级**搬用，不能当精确换算。
//
// 修法：判据改成机器无关的**单元预算**——不再写死秒数，而是
//   1. 用实测标定出「每单元耗时」的**上包络**（本机 61.7 ns，取 65 ns 作标定值），
//   2. 断言「上限档的单元数 × 标定值 ≤ 25 s」——这是**在标定机上**的预期耗时，
//      与具体机器无关（换机器只改变实际秒数，不改变这条断言）；
//   3. 另设一条「慢机器上限」的显式说明：3.4e8 × 65 ns ≈ 22 s（标定机），
//      慢 4 倍 ≈ 88 s，这个事实写进文档而不是藏进测试。
//
// 这样下一轮任何人想调上限，都会被「单元预算」这条等式挡住，不需要再拍本机秒数。

///|
/// 标定值：开发机实测「每工作单元耗时」的上包络（ns）。
///
/// 取 65 ns 而不是均值 51 ns：上表最高的一档是 61.7 ns（days 10，常数项占比
/// 最大），再加约 5% 抖动余量。它只用于「单元 → 预期秒数」的换算，
/// 不进实现（守卫本身仍只看整数单元）。
fn rc20_ns_per_unit() -> Int64 {
  65L
}

///|
test "rc20-1: 上限档的单元预算换算到标定机不超过 25 s" {
  // 上限档 = 上限本身（最慢一档就是它）；按标定值换算成预期秒数。
  let limit = advice_cost_limit()
  let ns = limit * rc20_ns_per_unit()
  // 25 s = 25e9 ns
  assert_true(ns <= 25000000000L)
}

///|
test "rc20-1: 默认档的单元预算换算到标定机不超过 25 s（且必须放行）" {
  let units = advice_cost_units(90, 200)
  assert_true(!advice_cost_over(90, 200))
  assert_true(units * rc20_ns_per_unit() <= 25000000000L)
}

///|
test "rc20-1: 旧缺陷档的单元预算必须远超 25 s（守卫不能再放它）" {
  // 99/500 = 2.46e9 单元 × 65 ns ≈ 160 s（实测 704 s——实测比标定值还慢，
  // 因为那一档的积压让它进了「每单元更贵」的高阶区）。
  let units = advice_cost_units(99, 500)
  assert_true(units * rc20_ns_per_unit() > 25000000000L)
  assert_true(advice_cost_over(99, 500))
}

///|
test "rc20-1: 实测表与标定值自洽（每单元耗时落在 30–70 ns）" {
  // 本机实测样本（单元数, 实测微秒）。这条用例锁的是「标定值别被随手改坏」。
  let measured : Array[(Int64, Int64)] = [
    (4040000L, 249000L),
    (16160000L, 685000L),
    (36360000L, 1640000L),
    (64640000L, 2517000L),
    (145440000L, 7699000L),
    (197960000L, 10408000L),
    (258560000L, 15631000L),
    (327240000L, 17906000L),
  ]
  for pair in measured {
    // ns/unit = 实测ns / 单元数
    let ns_per_unit = pair.1 * 1000L / pair.0
    assert_true(ns_per_unit >= 30L)
    assert_true(ns_per_unit <= 70L)
    // 标定值必须 ≥ 每个观测值，否则「预期秒数」就会低到骗人
    assert_true(rc20_ns_per_unit() >= ns_per_unit)
  }
}
