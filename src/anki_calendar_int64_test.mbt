// CB/RJ-A1（2026-11-10 审计）：timestamp_to_iso8601 的天数用 Int32 承载，
// 超过 ±2^31 天（ts ≥ 185,542,587,187,200 秒 ≈ 公元 588 万年）后静默回绕。
//
// ## 缺陷形态（修复前）
//
// anki.mbt 的 civil_from_days 里 `days.to_int()` 把天数字段压进 Int32，
// 之后 z/era/doe/yoe/y 全在 Int32 域运算：
//
//   - `timestamp_to_iso8601(9223372036854775807L)`（API 承诺可解析的
//     完整 Int64 上限）返回 `1587287-03-17 15:30:07`——真值应是
//     `292277026596-12-04 15:30:07`（差约 2.9e11 年）
//   - 106751991167300 mod 2^32 = 579025220，civil(579025220) 恰为
//     1587287-03-17；时分秒因 rem 仍在 Int64 域计算而侥幸正确
//
// 加重项：旧测试（RC-6）把回绕产物 `1587287-03-17 15:30:07` 当期望值
// 锁死，API.md 也把它写成「Int64 上限对应的日期」——回绕垃圾被固化成
// 域事实。可达链：`add_days(..., 16.0)` 按文档饱和到 Int64.MAX 后，
// `export_anki_tsv` 的 due 列就会打出这个日期。
//
// 期望值全部由 Python 版 civil_from_days 独立复算（与本实现零共享代码）。

///|
test "RJ-A1: Int64 上限时间戳给出真实日期而不是回绕垃圾" {
  assert_eq(
    timestamp_to_iso8601(9223372036854775807L),
    "292277026596-12-04 15:30:07",
  )
  assert_eq(
    timestamp_to_iso8601(9223372036854775806L),
    "292277026596-12-04 15:30:06",
  )
}

///|
test "RJ-A1: 2^31 天分界两侧连续（回绕阈值处不再跳变）" {
  // 185542587187199 秒 = 2^31 天 - 1，修复前正确
  assert_eq(timestamp_to_iso8601(185542587187199L), "5881580-07-11 23:59:59")
  // 185542587187200 秒 = 恰好 2^31 天，修复前 days.to_int() 回绕
  assert_eq(timestamp_to_iso8601(185542587187200L), "5881580-07-12 00:00:00")
  // 再过一天，连续性也在
  assert_eq(
    timestamp_to_iso8601(185542587187200L + 86400L),
    "5881580-07-13 00:00:00",
  )
}

///|
test "RJ-A1: Int64 下限时间戳按 floor 语义给出负年份" {
  // 期望值由**两套独立算法**交叉确认：Fliegel–Van Flandern 儒略日公式
  // 与 Hinnant civil_from_days 各算一遍（前者不依赖 z-146096 技巧）。
  // 注意：先前有一份"floor 版 Hinnant 参考"把技巧与 floor 混用，得到
  // 01-28 的错值——技巧式 (z-146096)/146097 只在截断除法下成立，
  // 不能配 floor 除法用。
  assert_eq(
    timestamp_to_iso8601(-9223372036854775808L),
    "-292277022657-01-27 08:29:52",
  )
}

///|
test "RJ-A1: 修复不伤既有已知日期" {
  // 既有锚点（anki_test.mbt 的 RC-6 集）：0 / 闰日 / 9999 边界 / 负值 floor
  assert_eq(timestamp_to_iso8601(0L), "1970-01-01 00:00:00")
  assert_eq(timestamp_to_iso8601(951782400L), "2000-02-29 00:00:00")
  assert_eq(timestamp_to_iso8601(253402300799L), "9999-12-31 23:59:59")
  assert_eq(timestamp_to_iso8601(-1L), "1969-12-31 23:59:59")
  assert_eq(timestamp_to_iso8601(-2203977600L), "1900-02-28 00:00:00")
}
